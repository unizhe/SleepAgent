# Development/test dependencies extend the exact production input. The lock is
# generated on CPython 3.11.x with pip==24.0 and pip-tools==7.4.1:
#   python -m piptools compile --generate-hashes --resolver=backtracking \
#     --strip-extras --allow-unsafe \
#     --no-emit-index-url --no-emit-trusted-host \
#     --output-file=requirements/dev.lock requirements/dev.in

-r production.in

