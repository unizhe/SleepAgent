# Radar runtime
SLEEPAGENT_DEPLOYMENT_MODE=<production-or-development-or-test>
SLEEPAGENT_RADAR_AGENT_DATABASE_URL=<postgresql-url>
SLEEPAGENT_RADAR_AGENT_SQLITE_PATH=<local-sqlite-path-for-demo-only>
SLEEPAGENT_REPOSITORY_BACKEND=<jsonl-or-postgres>
SLEEPAGENT_LOG_LEVEL=<INFO-or-WARNING-or-ERROR>

# Backend/frontend
SLEEPAGENT_API_BASE_URL=<backend-api-base-url>
SLEEPAGENT_CORS_ORIGINS=<comma-separated-cors-origins>
NEXT_PUBLIC_SLEEPAGENT_API_BASE_URL=<browser-backend-api-base-url>
NEXT_PUBLIC_SLEEPAGENT_MOCK_MODE=<true-or-false>
NEXT_PUBLIC_SLEEPAGENT_RECORD_ID=<demo-record-id>
NEXT_PUBLIC_SLEEPAGENT_PATIENT_ID=<demo-patient-id>
NEXT_PUBLIC_RADAR_LIVE_API_ENABLED=<true-or-false>
NEXT_PUBLIC_RADAR_DEVICE_ID=<demo-radar-device-id>

# Product radar API
SLEEPAGENT_PRODUCT_RADAR_API_KEY=<product-radar-api-key>
# Required whenever the four-role ProductEpisodeRunner model is configured.
# This fixed binding is only for a controlled, single-subject deployment.
SLEEPAGENT_PRODUCT_ACTOR_ID=<authenticated-actor-id>
SLEEPAGENT_PRODUCT_ACTOR_ROLE=<elder-or-family-or-doctor>
SLEEPAGENT_PRODUCT_SUBJECT_ID=<authorized-subject-id>
SLEEPAGENT_PRODUCT_TIMEZONE=<iana-timezone>
SLEEPAGENT_RADAR_AGENT_API_KEY=<radar-agent-api-key>
SLEEPAGENT_RADAR_AGENT_ACTOR_ID=<authenticated-actor-id>
SLEEPAGENT_RADAR_AGENT_ACTOR_ROLE=<elder-or-family-or-doctor>
SLEEPAGENT_RADAR_AGENT_SUBJECT_ID=<authorized-subject-id>
SLEEPAGENT_RADAR_AGENT_AUTHORIZATION_ID=<active-data-authorization-id>
SLEEPAGENT_RADAR_AGENT_ROLE_BINDING_IDS=<comma-separated-role-binding-ids>
SLEEPAGENT_RADAR_AGENT_RUNTIME_MODE=<product-or-hybrid-or-dynamic-or-legacy>
SLEEPAGENT_RADAR_AGENT_DEV_MODE=<true-or-false>
# Legacy /product/radar and /radar-agent routes are available only when
# DEV_MODE=true outside production. Fake must also be explicit.
SLEEPAGENT_PRODUCT_RADAR_PROVIDER_MODE=<persistent-or-fake>
SLEEPAGENT_PRODUCT_RADAR_NAMESPACE=<live:tenant-or-replay:test-namespace>

# Canonical authority migration. Production must set this explicitly.
SLEEPAGENT_SLEEP_DATA_AUTHORITY=<legacy_compatibility-or-shadow-or-canonical>

# Unified immutable raw-payload encryption and retention.
SLEEP_DOMAIN_RAW_ENCRYPTION_KEY=<fernet-key>
SLEEP_DOMAIN_RAW_ENCRYPTION_KEY_ID=<rotatable-key-id>
SLEEP_DOMAIN_RAW_RETENTION_SECONDS=<positive-seconds>

# Independent /api/v1 sleep-domain service
# Production requires PostgreSQL, HTTPS, a live namespace, and every JSON
# authority/key setting below. Missing authority is fail-closed.
SLEEPAGENT_SLEEP_API_ENABLED=<true-or-false>
SLEEPAGENT_SLEEP_API_MODE=<production-or-development-or-test>
SLEEPAGENT_SLEEP_API_NAMESPACE=<live:opaque-tenant-or-replay:test-namespace>
SLEEPAGENT_SLEEP_API_AUDIENCE=<actor-jws-audience>
SLEEPAGENT_SLEEP_API_CURSOR_SECRET=<at-least-32-byte-secret>
SLEEPAGENT_SLEEP_API_EVENT_CURSOR_TTL_SECONDS=<60-to-604800>
SLEEPAGENT_SLEEP_API_EVENT_SCHEMA_GENERATION=<sleep-domain-events-v1>
# Local/test compatibility only; production uses the SLEEP_DOMAIN_RAW_* policy.
SLEEPAGENT_SLEEP_API_RAW_FERNET_KEY=<local-test-fernet-key>
SLEEPAGENT_SLEEP_API_SERVICE_CREDENTIALS_JSON=<rotating-service-credentials-json>
SLEEPAGENT_SLEEP_API_ACTOR_KEYS_JSON=<rotating-public-jws-keys-json>
SLEEPAGENT_SLEEP_API_ROLE_BINDINGS_JSON=<authoritative-role-bindings-json>
SLEEPAGENT_SLEEP_API_VERSION_PINS_JSON=<episode-version-pins-json>

# Habit Profile UI identity is server-side and fail-closed when unset.
# This fixed binding is only for a controlled, single-subject usability deployment.
SLEEPAGENT_HABIT_PROFILE_ACTOR_ID=<authenticated-elder-actor-id>
SLEEPAGENT_HABIT_PROFILE_ACTOR_ROLE=elder
SLEEPAGENT_HABIT_PROFILE_SUBJECT_ID=<elder-subject-id>
SLEEPAGENT_HABIT_PROFILE_AUTHORIZATION_SCOPES=<comma-separated-scopes>

# Perceptor provider
PERCEPTOR_PROVIDER_MODE=<fake-or-live>
SLEEPAGENT_PERCEPTOR_DATA_NAMESPACE=<live:tenant-or-replay:test-namespace>
PERCEPTOR_BASE_URL=<perceptor-base-url>
PERCEPTOR_CLIENT_ID=<perceptor-client-id>
PERCEPTOR_CLIENT_SECRET=<perceptor-client-secret>
PERCEPTOR_DEFAULT_DEVICE_NAME=<perceptor-device-name>
PERCEPTOR_DEFAULT_HOME_ID=<perceptor-home-id>
PERCEPTOR_TIMEOUT_SECONDS=<seconds>
PERCEPTOR_TOKEN_REFRESH_MARGIN_SECONDS=<seconds>
PERCEPTOR_TOKEN_DEFAULT_TTL_SECONDS=<seconds>
PERCEPTOR_REALTIME_SESSION_TTL_SECONDS=<seconds>
PERCEPTOR_MAX_RETRIES=<integer>
PERCEPTOR_RETRY_BACKOFF_SECONDS=<seconds>
PERCEPTOR_SIGNING_PATH=<perceptor-signing-path>
PERCEPTOR_SIGN_SECRET_APPEND_AMPERSAND=<true-or-false>

# Deprecated local webhook diagnostic/import source. Never production authority.
SLEEPAGENT_LEGACY_PERCEPTOR_DIAGNOSTIC=<true-only-for-local-diagnostics>
PERCEPTOR_WEBHOOK_SECRET=<perceptor-webhook-secret>
PERCEPTOR_WEBHOOK_ALLOW_UNSIGNED_DEV_ONLY=<true-or-false>
PERCEPTOR_WEBHOOK_SIGNING_PATH=<perceptor-webhook-signing-path>
PERCEPTOR_WEBHOOK_STORE_DIR=<local-webhook-store-dir>

# Unified Perceptor push intake. Capabilities remain PENDING until real callback
# signing/retry behavior is confirmed. Production requires the shared PostgreSQL
# URL above; standalone SQLite is accepted only for explicit local/test use.
SLEEPAGENT_PERCEPTOR_PUSH_ENABLED=<true-or-false>
SLEEPAGENT_PERCEPTOR_PUSH_WORKER_ENABLED=<true-or-false>
SLEEPAGENT_PERCEPTOR_PUSH_NAMESPACE=<live-or-replay:opaque-namespace>
SLEEPAGENT_PERCEPTOR_PUSH_PROVIDER_ACCOUNT_ID=<opaque-provider-account-id>
SLEEPAGENT_PERCEPTOR_PUSH_PROFILE_ID=<compatibility-profile-id>
SLEEPAGENT_PERCEPTOR_PUSH_SIGNING_SECRET=<vendor-issued-secret>
SLEEPAGENT_PERCEPTOR_PUSH_SIGNATURE_ALGORITHM=<HMAC-SHA1-or-HMAC-SHA256>
SLEEPAGENT_PERCEPTOR_PUSH_SIGNATURE_MODE=<canonical_parameters-or-raw_body>
SLEEPAGENT_PERCEPTOR_PUSH_ENVIRONMENT=<production-or-test>
SLEEPAGENT_PERCEPTOR_PUSH_CONFIGURATION_FINGERPRINT=<lowercase-sha256>
SLEEPAGENT_PERCEPTOR_PUSH_ADAPTER_ARTIFACT_SHA256=<lowercase-sha256>
SLEEPAGENT_PERCEPTOR_PUSH_TIMESTAMP_WINDOW_SECONDS=<positive-seconds>
SLEEPAGENT_PERCEPTOR_PUSH_FUTURE_SKEW_SECONDS=<nonnegative-seconds>
SLEEPAGENT_PERCEPTOR_PUSH_MAX_BODY_BYTES=<positive-bytes>
SLEEPAGENT_PERCEPTOR_PUSH_MAX_HEADER_COUNT=<positive-count>
SLEEPAGENT_PERCEPTOR_PUSH_MAX_HEADER_BYTES=<positive-bytes>
SLEEPAGENT_PERCEPTOR_PUSH_RATE_REQUESTS=<positive-count>
SLEEPAGENT_PERCEPTOR_PUSH_RATE_WINDOW_SECONDS=<positive-seconds>

# Product dialogue LLM
DEEPSEEK_API_KEY=<deepseek-api-key>
SLEEPAGENT_PRODUCT_LLM_MODEL=<deepseek-model-name>
SLEEPAGENT_PRODUCT_LLM_BASE_URL=<openai-compatible-base-url>
SLEEPAGENT_PRODUCT_LLM_TIMEOUT_SECONDS=<seconds>
SLEEPAGENT_PRODUCT_LLM_MAX_TOKENS=<integer>

# Confirmed external actions are disabled unless their exact gateway is set.
# Non-local endpoints must use HTTPS and must return a request ID plus
# pending/delivered status.
SLEEPAGENT_EXTERNAL_NOTIFY_URL=<https-notification-gateway-url>
SLEEPAGENT_EXTERNAL_SHARE_URL=<https-share-gateway-url>
SLEEPAGENT_EXTERNAL_EXPORT_URL=<https-export-gateway-url>
SLEEPAGENT_EXTERNAL_ACTION_API_KEY=<external-gateway-api-key>
SLEEPAGENT_EXTERNAL_ACTION_TIMEOUT_SECONDS=<seconds>

# Radar Agent OpenAI-compatible LLM. Dynamic tasks use safe_degraded mode when unset;
# a deterministic result is never reported as an intelligent Agent invocation.
SLEEPAGENT_RADAR_AGENT_LLM_BASE_URL=<openai-compatible-base-url>
SLEEPAGENT_RADAR_AGENT_LLM_API_KEY=<radar-agent-llm-api-key>
SLEEPAGENT_RADAR_AGENT_LLM_MODEL_ID=<model-id>
SLEEPAGENT_RADAR_AGENT_LLM_TIMEOUT_SECONDS=<seconds>
SLEEPAGENT_RADAR_AGENT_LLM_RETRY=<0-to-5>
SLEEPAGENT_RADAR_AGENT_REQUIRE_PROVIDER_REQUEST_ID=<true-or-false>
