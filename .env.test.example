# SleepAgent replay-only backend integration profile.
# These values are public test placeholders. Never reuse them outside an
# isolated local/CI database. Copy this file to the ignored `.env.test`.

SLEEPAGENT_SETTINGS_PROFILE=test-postgres
SLEEPAGENT_BACKEND_PROFILE=test-postgres
SLEEPAGENT_BACKEND_DEPLOYMENT_MODE=test
SLEEPAGENT_BACKEND_DATA_MODE=replay
SLEEPAGENT_BACKEND_PROCESS_ROLE=api
SLEEPAGENT_BACKEND_ENABLED_SURFACES=public_v1,product,internal,demo
SLEEPAGENT_BACKEND_NAMESPACE_PREFIXES=replay:backend-test
SLEEPAGENT_BACKEND_DATABASE_SCOPE=replay
SLEEPAGENT_BACKEND_DATABASE_IDENTITY=sleepagent_replay_test
SLEEPAGENT_BACKEND_DATABASE_ROLE=sleepagent_test_api
SLEEPAGENT_BACKEND_SERVICE_PRINCIPAL_ID=sleepagent-api-test
SLEEPAGENT_BACKEND_SERVICE_CREDENTIAL_REF=test:key-provider/api-service-credential
SLEEPAGENT_BACKEND_SIGNING_KEY_REF=test:key-provider/signing
SLEEPAGENT_BACKEND_ENCRYPTION_KEY_REF=test:key-provider/encryption
SLEEPAGENT_BACKEND_INTERNAL_AUTH_TOKEN=test-only-internal-auth-token-do-not-use
SLEEPAGENT_BACKEND_DEMO_CONTROLLER_TOKEN=test-only-demo-controller-token-do-not-use

SLEEPAGENT_TEST_POSTGRES_HOST_PORT=15432
SLEEPAGENT_TEST_POSTGRES_DB=sleepagent_replay_test
SLEEPAGENT_TEST_POSTGRES_ADMIN_USER=sleepagent_test_migration
SLEEPAGENT_TEST_POSTGRES_ADMIN_PASSWORD=test-only-migration-password
SLEEPAGENT_TEST_POSTGRES_API_USER=sleepagent_test_api
SLEEPAGENT_TEST_POSTGRES_API_PASSWORD=test-only-api-password
SLEEPAGENT_TEST_POSTGRES_WORKER_USER=sleepagent_test_worker
SLEEPAGENT_TEST_POSTGRES_WORKER_PASSWORD=test-only-worker-password

# Host-side DSN used by pytest. Container DSNs are assembled in compose.yaml.
SLEEPAGENT_BACKEND_DATABASE_DSN=postgresql://sleepagent_test_api:test-only-api-password@127.0.0.1:15432/sleepagent_replay_test
SLEEPAGENT_TEST_DATABASE_URL=postgresql://sleepagent_test_api:test-only-api-password@127.0.0.1:15432/sleepagent_replay_test
SLEEPAGENT_TEST_POSTGRES_ADMIN_DSN=postgresql://sleepagent_test_migration:test-only-migration-password@127.0.0.1:15432/sleepagent_replay_test
SLEEPAGENT_TEST_POSTGRES_API_DSN=postgresql://sleepagent_test_api:test-only-api-password@127.0.0.1:15432/sleepagent_replay_test
SLEEPAGENT_TEST_POSTGRES_WORKER_DSN=postgresql://sleepagent_test_worker:test-only-worker-password@127.0.0.1:15432/sleepagent_replay_test
SLEEPAGENT_TEST_POSTGRES_API_PRINCIPAL=sleepagent-api-test
SLEEPAGENT_TEST_POSTGRES_WORKER_PRINCIPAL=sleepagent-worker-test

SLEEPAGENT_BACKEND_POOL_MIN_SIZE=1
SLEEPAGENT_BACKEND_POOL_MAX_SIZE=5
SLEEPAGENT_API_POOL_MIN_SIZE=1
SLEEPAGENT_API_POOL_MAX_SIZE=5
SLEEPAGENT_WORKER_POOL_MIN_SIZE=1
SLEEPAGENT_WORKER_POOL_MAX_SIZE=4
SLEEPAGENT_MIGRATION_POOL_MIN_SIZE=1
SLEEPAGENT_MIGRATION_POOL_MAX_SIZE=1
SLEEPAGENT_BACKEND_WORKER_QUEUES=
SLEEPAGENT_TEST_WORKER_QUEUES=ingestion,fast_path,product_agent,induction,delivery,retention,reconciliation

# Deterministic test references are identifiers, not key material. Production
# configuration must point at a real key provider instead.
